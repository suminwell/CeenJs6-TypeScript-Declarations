  "scripts": {
    "test": "npm run test:api && npm run test:compose && npm run test:colors && npm run test:terminal && npm run test:consumer",
    "test:api": "node tools/verify-api-coverage.mjs",
    "test:compose": "node tools/verify-compose-tsx.mjs --typescript node_modules/typescript/lib/typescript.js",
    "test:colors": "node tools/verify-colors.mjs node_modules/typescript/lib/typescript.js",
    "test:terminal": "node tools/verify-terminal.mjs node_modules/typescript/lib/typescript.js",
    "test:consumer": "node tools/verify-consumer.mjs",
    "prepack": "npm run docs:check",
    "release:prepare": "python tools/prepare-release.py",
    "docs:generate": "python .python/generate_markdown.py",
